HOST=127.0.0.1
PORT=3000
FLASK_DEBUG=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini API key for prompt-to-alpha generation (keep secret; never expose in frontend)
GEMINI_API_KEY=
# Use a model that is enabled for your Google AI Studio project
GEMINI_MODEL=gemini-3.8-flash
# Optional cheaper/smaller model for long-prompt compression. Defaults to GEMINI_MODEL.
GEMINI_COMPRESS_MODEL=gemini-3.8-flash

# Prompt optimization controls
PROMPT_COMPRESSION_ENABLED=1
PROMPT_COMPRESS_THRESHOLD=700
PROMPT_MAX_CHARS=20000
PROMPT_CONTEXT_FIELD_LIMIT=80
